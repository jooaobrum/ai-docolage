# Copy to .env and fill in real values for anything beyond local dev.
# docker-compose.yml reads these directly; docolage_service/config.py
# reads the DOCOLAGE_-prefixed ones itself (env_file=".env") when running
# outside compose.

POSTGRES_USER=docolage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docolage

MINIO_ROOT_USER=docolage
MINIO_ROOT_PASSWORD=change-me

# Optional: enables the OpenAI recognition fallback and figure captioning
# (ADR-0010). Unset -> both features degrade to "off", nothing fails.
OPENAI_API_KEY=

# Only needed when running the API/Worker outside docker-compose (compose
# builds DOCOLAGE_POSTGRES_DSN / DOCOLAGE_OBJECT_STORAGE_* itself from the
# vars above).
# DOCOLAGE_POSTGRES_DSN=postgresql://docolage:change-me@localhost:5433/docolage
# DOCOLAGE_OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
# DOCOLAGE_OBJECT_STORAGE_ACCESS_KEY=docolage
# DOCOLAGE_OBJECT_STORAGE_SECRET_KEY=change-me
